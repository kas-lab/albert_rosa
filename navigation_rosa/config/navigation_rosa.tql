insert

# === QUALITY ATTRIBUTE: Battery Level ===
$battery_level_qa isa QualityAttribute, 
  has measure-name "battery-level",
  has description "Battery charge percentage";

$corridor_width_qa isa QualityAttribute,
  has measure-name "current-corridor-width",
  has description "Width of corridor being traversed (meters)";
# Initial battery measurement
(measured-attribute: $battery_level_qa) isa measurement,
  has measurement-value 100.0,
  has latest true;

# Initial predicted battery = 100% (no plan yet)
(measured-attribute: $predicted_battery_qa) isa measurement,
  has measurement-value 100.0,
  has latest true;

$predicted_battery_qa isa QualityAttribute,
  has measure-name "predicted-battery-level",
  has description "Predicted battery level after current plan completion";

# === ACTIONS ===
$a_move_lit isa Action, 
  has action-name "move_lit";

$a_move_dark isa Action, 
  has action-name "move_dark";

$a_recharge isa Action,
  has action-name "recharge";

$a_move_to_recharge isa Action, 
  has action-name "move_to_recharge";

# Requires same function as move_lit (navigation controller)
(action: $a_move_to_recharge, required-function: $f_controller_lit) 
  isa functional-requirement;

# === DEGRADED MODE COMPONENTS ===
$c_perception isa Component,
  has component-name "perception_node",
  has is-active true;  # Can be deactivated

$c_arm isa Component,
  has component-name "arm_controller",
  has is-active true;  # Can be deactivated

# === Battery constraints on move actions ===
(constraint: $predicted_battery_qa, constrained: $a_move_lit)
  isa constraint,
  has attribute-value 5.0,
  has constraint-operator ">=";

(constraint: $predicted_battery_qa, constrained: $a_move_dark)
  isa constraint,
  has attribute-value 5.0,
  has constraint-operator ">=";


# === Component activation constraints ===
# Perception deactivates when battery critical
(constraint: $predicted_battery_qa, constrained: $c_perception)
  isa constraint,
  has attribute-value 10.0,
  has constraint-operator ">=";

# Arm reduces to low power when battery critical  
(constraint: $predicted_battery_qa, constrained: $c_arm)
  isa constraint,
  has attribute-value 15.0,
  has constraint-operator ">=";

# # === QUALITY ATTRIBUTE: Lighting Level ===
# $lighting_qa isa QualityAttribute,
#   has measure-name "current-lighting-level",
#   has description "Lighting quality: 1.0 = lit, 0.0 = dark";

# # Initial lighting measurement
# (measured-attribute: $lighting_qa) isa measurement,
#   has measurement-value 1.0,
#   has latest true;

# # === Constraint: High-speed requires good lighting ===
# (constraint: $lighting_qa, constrained: $cc_high_speed)
#   isa constraint,
#   has attribute-value 0.5,      # Requires lighting > 0.5
#   has constraint-operator ">";

# === FUNCTIONS ===
$f_controller_lit isa Function, 
  has function-name "controller_lit",
  has always-improve true;

$f_controller_dark isa Function, 
  has function-name "controller_dark",
  has always-improve true;

# === FUNCTIONAL REQUIREMENTS ===
(action: $a_move_lit, required-function: $f_controller_lit) 
  isa functional-requirement;

(action: $a_move_dark, required-function: $f_controller_dark) 
  isa functional-requirement;

# === COMPONENT: Nav2 Controller Server ===
$c_controller_server isa Component,
  has component-name "controller_server",
  has is-active true,
  has always-improve true;

# === FUNCTION DESIGNS ===
$fd_lit (function: $f_controller_lit, required-component: $c_controller_server)
  isa function-design,
  has function-design-name "fd_controller_lit",
  has is-selected true,
  has priority 1.0;

$fd_dark (function: $f_controller_dark, required-component: $c_controller_server)
  isa function-design,
  has function-design-name "fd_controller_dark",
  has is-selected true,
  has priority 1.0;

# === COMPONENT PARAMETERS ===
# === HIGH SPEED CONFIGURATION ===
$cp_max_vel_x_high isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_x",
  has parameter-value "2.0",
  has parameter-type "double";

$cp_max_vel_theta_high isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_theta",
  has parameter-value "1.0",
  has parameter-type "double";

# === LOW SPEED CONFIGURATION ===
$cp_max_vel_x_low isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_x",
  has parameter-value "1.6",
  has parameter-type "double";

$cp_max_vel_theta_low isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_theta",
  has parameter-value "1.6",
  has parameter-type "double";

# === DEGRADED SPEED CONFIGURATION ===
$cp_max_vel_x_degraded isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_x",
  has parameter-value "1.2",
  has parameter-type "double";

$cp_max_vel_theta_degraded isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_theta",
  has parameter-value "1.2",
  has parameter-type "double";

# === COMPONENT CONFIGURATIONS ===
$cc_high_speed (component: $c_controller_server,
                parameter: $cp_max_vel_x_high,
                parameter: $cp_max_vel_theta_high)
  isa component-configuration,
  has component-configuration-name "high_speed_config",
  has component-configuration-status "feasible",
  has is-selected true,
  has priority 1.0;

$cc_low_speed (component: $c_controller_server,
               parameter: $cp_max_vel_x_low,
               parameter: $cp_max_vel_theta_low)
  isa component-configuration,
  has component-configuration-name "low_speed_config",
  has component-configuration-status "feasible",
  has is-selected false,
  has priority 2.0;

  $cc_degraded (component: $c_controller_server,
              parameter: $cp_max_vel_x_degraded,
              parameter: $cp_max_vel_theta_degraded)
  isa component-configuration,
  has component-configuration-name "degraded_speed_config",
  has component-configuration-status "feasible",
  has is-selected false,
  has priority 3.0;

# === PROACTIVE CONSTRAINTS (based on prediction) ===
(constraint: $predicted_battery_qa, constrained: $a_move_to_recharge)
  isa constraint,
  has attribute-value 5.0,  # Only use when predicted < 10%
  has constraint-operator "<";

# === HIGH-SPEED: Use when predicted >= 50% ===
(constraint: $predicted_battery_qa, constrained: $cc_high_speed)
  isa constraint,
  has attribute-value 30.0,
  has constraint-operator ">=";

#=== LOW-SPEED: Use when 5% <= predicted < 20% ===
# (constraint: $predicted_battery_qa, constrained: $cc_low_speed)
#   isa constraint,
#   has attribute-value 20.0,
#   has constraint-operator "<";

(constraint: $predicted_battery_qa, constrained: $cc_low_speed)
  isa constraint,
  has attribute-value 20.0,
  has constraint-operator ">=";

# === DEGRADED: < 8% ===

(constraint: $predicted_battery_qa, constrained: $cc_degraded)
  isa constraint,
  has attribute-value 10.0,
  has constraint-operator "<";


# === Corridor Widh Constraints Safety Levels ===
(constraint: $corridor_width_qa, constrained: $cc_high_speed)
  isa constraint,
  has attribute-value 1.4,
  has constraint-operator ">=";

(constraint: $corridor_width_qa, constrained: $cc_low_speed)
  isa constraint,
  has attribute-value 0.8,
  has constraint-operator ">=";

# (constraint: $corridor_width_qa, constrained: $cc_low_speed)
#   isa constraint,
#   has attribute-value 1.4,
#   has constraint-operator "<=";


# === WAYPOINTS (EXTENDED) ===
$wp0  isa waypoint, has waypoint-name "wp_0",  has risk-level "safe";
$wp1  isa waypoint, has waypoint-name "wp_1",  has risk-level "safe";
$wp2  isa waypoint, has waypoint-name "wp_2",  has risk-level "safe";
$wp3  isa waypoint, has waypoint-name "wp_3",  has has-charging-station true,  has risk-level "moderate";
$wp4  isa waypoint, has waypoint-name "wp_4",  has risk-level "safe";
$wp5  isa waypoint, has waypoint-name "wp_5",  has risk-level "high";      # Narrow area
$wp6  isa waypoint, has waypoint-name "wp_6",  has risk-level "high";      # Congested area
$wp7  isa waypoint, has waypoint-name "wp_7",  has has-charging-station true,  has risk-level "safe";
$wp8  isa waypoint, has waypoint-name "wp_8",  has risk-level "safe";
$wp9  isa waypoint, has waypoint-name "wp_9",  has has-charging-station true,  has risk-level "safe";
$wp10 isa waypoint, has waypoint-name "wp_10", has risk-level "safe";

# New waypoints
$wp11 isa waypoint, has waypoint-name "wp_11", has risk-level "safe";
$wp12 isa waypoint, has waypoint-name "wp_12", has risk-level "moderate";
$wp13 isa waypoint, has waypoint-name "wp_13", has has-charging-station true, has risk-level "safe";     # NEW CHARGER
$wp14 isa waypoint, has waypoint-name "wp_14", has risk-level "safe";
$wp15 isa waypoint, has waypoint-name "wp_15", has risk-level "high";       # Narrow-ish / constrained
$wp16 isa waypoint, has waypoint-name "wp_16", has risk-level "moderate";
$wp17 isa waypoint, has waypoint-name "wp_17", has risk-level "safe";
$wp18 isa waypoint, has waypoint-name "wp_18", has has-charging-station true, has risk-level "safe";    # NEW CHARGER
$wp19 isa waypoint, has waypoint-name "wp_19", has risk-level "safe";
$wp20 isa waypoint, has waypoint-name "wp_20", has risk-level "safe";


## === CORRIDORS (EXTENDED TO 20) ===
$c01 (from: $wp0, to: $wp1) isa corridor,
  has distance 2.5,
  has corridor-width 1.8,
  has obstacle-density "low",
  has max-safe-speed 2.0;

$c10 (from: $wp1, to: $wp0) isa corridor,
  has distance 2.5,
  has corridor-width 1.8,
  has obstacle-density "low",
