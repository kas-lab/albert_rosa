insert

# --- Battery Level (REAL battery)
$battery_level_qa isa QualityAttribute, 
  has measure-name "battery-level",
  has description "Battery charge percentage";

# Initial battery (real)
(measured-attribute: $battery_level_qa) isa measurement,
  has measurement-value 100.0,
  has latest true;


# --- Corridor width attribute
$corridor_width_qa isa QualityAttribute,
  has measure-name "current-corridor-width",
  has description "Width of corridor being traversed (meters)";


###############################################################################
# ACTIONS
###############################################################################

$a_move_lit isa Action, has action-name "move_lit";
$a_move_dark isa Action, has action-name "move_dark";
$a_recharge isa Action, has action-name "recharge";
$a_move_to_recharge isa Action, has action-name "move_to_recharge";

(action: $a_move_to_recharge, required-function: $f_controller_lit) 
  isa functional-requirement;


###############################################################################
# COMPONENTS
###############################################################################

$c_perception isa Component,
  has component-name "perception_node",
  has is-active true;

$c_arm isa Component,
  has component-name "arm_controller",
  has is-active true;

# Nav2 controller server
$c_controller_server isa Component,
  has component-name "controller_server",
  has is-active true,
  has always-improve true;


###############################################################################
# FUNCTIONS + REQUIREMENTS
###############################################################################

$f_controller_lit isa Function, 
  has function-name "controller_lit",
  has always-improve true;

$f_controller_dark isa Function, 
  has function-name "controller_dark",
  has always-improve true;

(action: $a_move_lit, required-function: $f_controller_lit) 
  isa functional-requirement;

(action: $a_move_dark, required-function: $f_controller_dark) 
  isa functional-requirement;

$fd_lit (function: $f_controller_lit, required-component: $c_controller_server)
  isa function-design, has function-design-name "fd_controller_lit",
  has is-selected true, has priority 1.0;

$fd_dark (function: $f_controller_dark, required-component: $c_controller_server)
  isa function-design, has function-design-name "fd_controller_dark",
  has is-selected true, has priority 1.0;


###############################################################################
# COMPONENT PARAMETERS (CONFIGS)
###############################################################################

# HIGH SPEED
$cp_max_vel_x_high isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_x",
  has parameter-value "2.0",
  has parameter-type "double";

$cp_max_vel_theta_high isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_theta",
  has parameter-value "1.0",
  has parameter-type "double";

# LOW SPEED
$cp_max_vel_x_low isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_x",
  has parameter-value "1.6",
  has parameter-type "double";

$cp_max_vel_theta_low isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_theta",
  has parameter-value "1.6",
  has parameter-type "double";

# DEGRADED SPEED
$cp_max_vel_x_degraded isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_x",
  has parameter-value "1.2",
  has parameter-type "double";

$cp_max_vel_theta_degraded isa ComponentParameter,
  has parameter-key "FollowPath.max_vel_theta",
  has parameter-value "1.2",
  has parameter-type "double";


###############################################################################
# COMPONENT CONFIGURATIONS
###############################################################################

$cc_high_speed (component: $c_controller_server,
                parameter: $cp_max_vel_x_high,
                parameter: $cp_max_vel_theta_high)
  isa component-configuration,
  has component-configuration-name "high_speed_config",
  has component-configuration-status "feasible",
  has is-selected true,
  has priority 1.0;

$cc_low_speed (component: $c_controller_server,
               parameter: $cp_max_vel_x_low,
               parameter: $cp_max_vel_theta_low)
  isa component-configuration,
  has component-configuration-name "low_speed_config",
  has component-configuration-status "feasible",
  has is-selected false,
  has priority 2.0;

$cc_degraded (component: $c_controller_server,
              parameter: $cp_max_vel_x_degraded,
              parameter: $cp_max_vel_theta_degraded)
  isa component-configuration,
  has component-configuration-name "degraded_speed_config",
  has component-configuration-status "feasible",
  has is-selected false,
  has priority 3.0;


###############################################################################
# REACTIVE BATTERY-LEVEL CONSTRAINTS (NO PREDICTED BATTERY)
###############################################################################



(constraint: $battery_level_qa, constrained: $a_move_to_recharge)
  isa constraint,
  has attribute-value 5.0,  # Only use when predicted < 10%
  has constraint-operator "<";

# move_lit requires >= 5%
(constraint: $battery_level_qa, constrained: $a_move_lit)
  isa constraint,
  has attribute-value 5.0,
  has constraint-operator ">=";

# move_dark requires >= 5%
(constraint: $battery_level_qa, constrained: $a_move_dark)
  isa constraint,
  has attribute-value 5.0,
  has constraint-operator ">=";


# HIGH-SPEED ALLOWED when battery >= 70%
(constraint: $battery_level_qa, constrained: $cc_high_speed)
  isa constraint,
  has attribute-value 30.0,
  has constraint-operator ">=";

# LOW-SPEED for 40%–70%
(constraint: $battery_level_qa, constrained: $cc_low_speed)
  isa constraint,
  has attribute-value 15.0,
  has constraint-operator ">=";

(constraint: $battery_level_qa, constrained: $cc_low_speed)
  isa constraint,
  has attribute-value 30.0,
  has constraint-operator "<";

# DEGRADED below 40%
(constraint: $battery_level_qa, constrained: $cc_degraded)
  isa constraint,
  has attribute-value 10.0,
  has constraint-operator "<=";


# COMPONENT REACTIONS (reactive)
(constraint: $battery_level_qa, constrained: $c_perception)
  isa constraint,
  has attribute-value 25.0,
  has constraint-operator ">=";

(constraint: $battery_level_qa, constrained: $c_arm)
  isa constraint,
  has attribute-value 30.0,
  has constraint-operator ">=";


###############################################################################
# CORRIDOR WIDTH CONSTRAINTS (kept exactly)
###############################################################################

(constraint: $corridor_width_qa, constrained: $cc_high_speed)
  isa constraint,
  has attribute-value 1.4,
  has constraint-operator ">=";

(constraint: $corridor_width_qa, constrained: $cc_low_speed)
  isa constraint,
  has attribute-value 0.8,
  has constraint-operator ">=";

(constraint: $corridor_width_qa, constrained: $cc_degraded)
  isa constraint,
  has attribute-value 0.5,
  has constraint-operator ">=";

# === WAYPOINTS ===
$wp0 isa waypoint, has waypoint-name "wp_0", has risk-level "safe";
$wp1 isa waypoint, has waypoint-name "wp_1", has has-charging-station true, has risk-level "safe";
$wp2 isa waypoint, has waypoint-name "wp_2", has risk-level "safe";
$wp3 isa waypoint, has waypoint-name "wp_3", has has-charging-station true, has risk-level "moderate";
$wp4 isa waypoint, has waypoint-name "wp_4", has risk-level "safe";
$wp5 isa waypoint, has waypoint-name "wp_5", has risk-level "high";  # Narrow area
$wp6 isa waypoint, has waypoint-name "wp_6", has risk-level "high";  # Congested area
$wp7 isa waypoint, has waypoint-name "wp_7", has has-charging-station true, has risk-level "safe";
$wp8 isa waypoint, has waypoint-name "wp_8", has risk-level "safe";
$wp9 isa waypoint, has waypoint-name "wp_9", has has-charging-station true, has risk-level "safe";
$wp10 isa waypoint, has waypoint-name "wp_10", has risk-level "safe";

# === CORRIDORS ===
# === CORRIDORS WITH SAFETY DATA ===
$c01 (from: $wp0, to: $wp1) isa corridor, 
  has distance 2.5,
  has corridor-width 1.8,      # ← Wide, safe corridor
  has obstacle-density "low",
  has max-safe-speed 2.0;

$c12 (from: $wp1, to: $wp2) isa corridor, 
  has distance 2.5,
  has corridor-width 1.8,
  has obstacle-density "low",
  has max-safe-speed 2.0;

$c23 (from: $wp2, to: $wp3) isa corridor, 
  has distance 2.5,
  has corridor-width 1.8,      # ← Medium width
  has obstacle-density "medium",
  has max-safe-speed 1.5;

$c34 (from: $wp3, to: $wp4) isa corridor, 
  has distance 2.5,
  has corridor-width 1.8,
  has obstacle-density "low",
  has max-safe-speed 1.8;

$c45 (from: $wp4, to: $wp5) isa corridor, 
  has distance 2.5,
  has corridor-width 0.9,      # ← NARROW! High-speed unsafe
  has obstacle-density "high",
  has max-safe-speed 0.8;

$c56 (from: $wp5, to: $wp6) isa corridor, 
  has distance 2.5,
  has corridor-width 0.8,      # ← VERY NARROW! Only degraded mode
  has obstacle-density "high",
  has max-safe-speed 0.6;

$c67 (from: $wp6, to: $wp7) isa corridor, 
  has distance 2.5,
  has corridor-width 1.7,      # ← Returning to normal
  has obstacle-density "medium",
  has max-safe-speed 1.0;

$c78 (from: $wp7, to: $wp8) isa corridor, 
  has distance 2.5,
  has corridor-width 1.7,
  has obstacle-density "low",
  has max-safe-speed 1.5;

$c89 (from: $wp8, to: $wp9) isa corridor, 
  has distance 2.5,
  has corridor-width 1.7,      # ← Wide again
  has obstacle-density "low",
  has max-safe-speed 2.0;

$c910 (from: $wp9, to: $wp10) isa corridor, 
  has distance 2.5,
  has corridor-width 1.8,
  has obstacle-density "low",
  has max-safe-speed 2.0;

# === LIGHTING CONDITIONS ===
$light01  (from: $wp0,  to: $wp1)   isa lighting-condition, has is-lit true, has is-dark false;
$light12  (from: $wp1,  to: $wp2)   isa lighting-condition, has is-lit true, has is-dark false;
$light23  (from: $wp2,  to: $wp3)   isa lighting-condition, has is-lit true, has is-dark false;
$light34  (from: $wp3,  to: $wp4)   isa lighting-condition, has is-lit true, has is-dark false;
$light45  (from: $wp4,  to: $wp5)   isa lighting-condition, has is-lit true, has is-dark false;
$light56  (from: $wp5,  to: $wp6)   isa lighting-condition, has is-lit true, has is-dark false;
$light67  (from: $wp6,  to: $wp7)   isa lighting-condition, has is-lit true, has is-dark false;
$light78  (from: $wp7,  to: $wp8)   isa lighting-condition, has is-lit true, has is-dark false;
$light89  (from: $wp8,  to: $wp9)   isa lighting-condition, has is-lit true, has is-dark false;
$light910 (from: $wp9,  to: $wp10)  isa lighting-condition, has is-lit true, has is-dark false;

# === GOAL ===
$goal1 isa goal, has goal-name "wp_30";
